{
    "$schema":"http://json-schema.org/draft-07/schema#",
    "$ref":"#/definitions/BaseObject",
    "definitions":{
        "BaseObject":{
            "type":["object","null"],
            "additionalProperties":false,
            "properties":{
                "dds":{
                    "$ref":"#/definitions/DDSConfigRecorder"
                },
                "recorder":{
                    "$ref":"#/definitions/RecorderConfig"
                },
                "remote-controller":{
                    "$ref":"#/definitions/RemoteControllerConfig"
                },
                "specs":{
                    "$ref":"#/definitions/SpecsConfig"
                }
            },
            "title":"BaseObject"
        },
        "DDSConfigRecorder":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "xml":{
                    "type":"object",
                    "additionalProperties":false,
                    "properties":{
                        "raw":{
                            "type":"string"
                        },
                        "files":{
                            "type":"array",
                            "minItems":1,
                            "items":{
                                "type":"string"
                            }
                        }
                    },
                    "anyOf":[
                        {
                            "required":[
                                "raw"
                            ]
                        },
                        {
                            "required":[
                                "files"
                            ]
                        }
                    ]
                },
                "recorder-profile":{
                    "type":"string"
                },
                "domain":{
                    "$ref":"#/definitions/DdsDomain"
                },
                "whitelist-interfaces":{
                    "type":"array",
                    "items":{
                        "type":"string"
                    }
                },
                "partitions":{
                    "type":"array",
                    "items":{
                        "type":"string"
                    }
                },
                "transport":{
                    "type":"string",
                    "enum":[
                        "builtin",
                        "udp",
                        "shm"
                    ]
                },
                "ros2-easy-mode":{
                    "$ref":"#/definitions/IPv4"
                },
                "ignore-participant-flags":{
                    "type":"string",
                    "enum":[
                        "no_filter",
                        "filter_different_host",
                        "filter_different_process",
                        "filter_same_process",
                        "filter_different_and_same_process"
                    ]
                },
                "allowlist":{
                    "type":"array",
                    "items":{
                        "$ref":"#/definitions/TopicFilter"
                    }
                },
                "blocklist":{
                    "type":"array",
                    "items":{
                        "$ref":"#/definitions/TopicFilter"
                    }
                },
                "topics":{
                    "type":"array",
                    "items":{
                        "$ref":"#/definitions/ManualTopic"
                    }
                },
                "topic":{
                    "$ref":"#/definitions/ManualTopic"
                },
                "builtin-topics":{
                    "type":"array",
                    "items":{
                        "$ref":"#/definitions/TopicBuiltins"
                    }
                }
            },
            "not":{
                "required":[
                    "topics",
                    "topic"
                ]
            },
            "title":"DDSConfigRecorder"
        },
        "RecorderConfig":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "output":{
                    "type":"object",
                    "additionalProperties":false,
                    "properties":{
                        "path":{
                            "type":"string"
                        },
                        "filename":{
                            "type":"string"
                        },
                        "timestamp-format":{
                            "type":"string"
                        },
                        "local-timestamp":{
                            "type":"boolean"
                        },
                        "safety-margin":{
                            "type":"string"
                        }
                    }
                },
                "buffer-size":{
                    "type":"integer",
                    "exclusiveMinimum":0
                },
                "cleanup-period":{
                    "type":"integer",
                    "exclusiveMinimum":0
                },
                "event-window":{
                    "type":"integer",
                    "exclusiveMinimum":0
                },
                "max-pending-samples":{
                    "type":"integer",
                    "minimum":-1
                },
                "only-with-type":{
                    "type":"boolean"
                },
                "record-types":{
                    "type":"boolean"
                },
                "ros2-types":{
                    "type":"boolean"
                },
                "mcap":{
                    "$ref":"#/definitions/MCAPConfig"
                },
                "sql":{
                    "$ref":"#/definitions/SQLConfig"
                }
            },
            "title":"RecorderConfig"
        },
        "MCAPConfig":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "enable":{
                    "type":"boolean"
                },
                "log-publish-time":{
                    "type":"boolean"
                },
                "compression":{
                    "type":"object",
                    "additionalProperties":false,
                    "properties":{
                        "algorithm":{
                            "type":"string",
                            "enum":[
                                "none",
                                "zstd",
                                "lz4"
                            ]
                        },
                        "level":{
                            "type":"string",
                            "enum":[
                                "fastest",
                                "fast",
                                "default",
                                "slow",
                                "slowest"
                            ]
                        },
                        "force":{
                            "type":"boolean"
                        }
                    }
                },
                "resource-limits":{
                    "$ref":"#/definitions/ResourceLimitConfig"
                }
            },
            "required":[
                "enable"
            ],
            "title":"MCAPConfig"
        },
        "SQLConfig":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "enable":{
                    "type":"boolean"
                },
                "data-format":{
                    "type":"string",
                    "enum":[
                        "cdr",
                        "json",
                        "both"
                    ]
                },
                "resource-limits":{
                    "$ref":"#/definitions/ResourceLimitConfig"
                }
            },
            "required":[
                "enable"
            ],
            "title":"SQLConfig"
        },
        "ResourceLimitConfig":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "log-rotation":{
                    "type":"boolean"
                },
                "max-file-size":{
                    "type":"string"
                },
                "max-size":{
                    "type":"string"
                },
                "size-tolerance":{
                    "type":"string"
                }
            },
            "title":"ResourceLimitConfig"
        },
        "RemoteControllerConfig":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "enable":{
                    "type":"boolean"
                },
                "domain":{
                    "$ref":"#/definitions/DdsDomain"
                },
                "initial-state":{
                    "type":"string",
                    "pattern":"^([Rr][Uu][Nn][Nn][Ii][Nn][Gg]|[Pp][Aa][Uu][Ss][Ee][Dd]|[Ss][Uu][Ss][Pp][Ee][Nn][Dd][Ee][Dd]|[Ss][Tt][Oo][Pp][Pp][Ee][Dd])$"
                },
                "command-topic-name":{
                    "type":"string"
                },
                "status-topic-name":{
                    "type":"string"
                }
            },
            "title":"RemoteControllerConfig"
        },
        "SpecsConfig":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "threads":{
                    "type":"integer",
                    "exclusiveMinimum":0
                },
                "qos":{
                    "$ref":"#/definitions/QOSRecorder"
                },
                "rtps":{
                    "type":"boolean"
                },
                "logging":{
                    "$ref":"#/definitions/LogConfig"
                },
                "monitor":{
                    "$ref":"#/definitions/MonitorConfig"
                }
            },
            "title":"SpecsConfig"
        },
        "QOSRecorder":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "durability":{
                    "type":"boolean"
                },
                "reliability":{
                    "type":"boolean"
                },
                "ownership":{
                    "type":"boolean"
                },
                "partitions":{
                    "type":"boolean"
                },
                "history-depth":{
                    "type":"integer",
                    "minimum":0
                },
                "keyed":{
                    "type":"boolean"
                },
                "max-rx-rate":{
                    "type":"number",
                    "minimum": 0
                },
                "downsampling":{
                    "type":"integer",
                    "minimum": 1
                }
            },
            "title": "QOSRecorder"
        },
        "LogConfig":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "publish":{
                    "type":"object",
                    "additionalProperties": false,
                    "properties": {
                        "enable":{
                            "type":"boolean"
                        },
                        "domain":{
                            "$ref":"#/definitions/DdsDomain"
                        },
                        "topic-name":{
                            "type":"string"
                        }
                    },
                    "required": [
                        "enable"
                    ]
                },
                "stdout":{
                    "type":"boolean"
                },
                "verbosity":{
                    "type":"string",
                    "enum":[
                        "info",
                        "warning",
                        "error"
                    ]
                },
                "filter":{
                    "type":"object",
                    "additionalProperties": false,
                    "properties": {
                        "info":{
                            "type":"string"
                        },
                        "warning":{
                            "type":"string"
                        },
                        "error":{
                            "type":"string"
                        }
                    }
                }
            }
        },
        "MonitorConfig":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "domain":{
                    "$ref":"#/definitions/DdsDomain"
                },
                "status":{
                    "$ref":"#/definitions/MonitorProducerConfig"
                },
                "topics":{
                    "$ref":"#/definitions/MonitorProducerConfig"
                }
            },
            "title": "MonitorConfig"
        },
        "MonitorProducerConfig":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "enable":{
                    "type":"boolean"
                },
                "domain":{
                    "$ref":"#/definitions/DdsDomain"
                },
                "period":{
                    "type":"number",
                    "exclusiveMinimum": 0
                },
                "topic-name":{
                    "type":"string"
                }
            },
            "required":[
                "enable"
            ],
            "title": "MonitorProducerConfig"
        },
        "TopicFilter":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "name":{
                    "type":"string"
                },
                "type":{
                    "type":"string"
                },
                "qos":{
                    "$ref":"#/definitions/QOSRecorder"
                },
                "filter":{
                    "type":"string"
                }
            },
            "required":[
                "name"
            ],
            "title":"TopicFilter"
        },
        "ManualTopic":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "name":{
                    "type":"string"
                },
                "type":{
                    "type":"string"
                },
                "qos":{
                    "$ref":"#/definitions/QOSRecorder"
                },
                "filter":{
                    "type":"string"
                },
                "participants":{
                    "type":"array",
                    "items":{
                        "type":"string"
                    }
                }
            },
            "required":[
                "name"
            ],
            "title":"ManualTopic"
        },
        "TopicBuiltins":{
            "type":"object",
            "additionalProperties":false,
            "properties":{
                "name":{
                    "type":"string"
                },
                "type":{
                    "type":"string"
                }
            },
            "required":[
                "name",
                "type"
            ],
            "title":"TopicBuiltins"
        },
        "IPv4":{
            "type":"string",
            "format":"v4",
            "title":"IPv4"
        },
        "DdsDomain":{
            "type":"integer",
            "minimum": 0,
            "maximum": 232,
            "title":"DdsDomain"
        }
    }
}
